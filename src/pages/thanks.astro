---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="max-w-3xl mx-auto px-6 py-24">
    <section class="rounded-3xl border border-white/20 bg-slate-950/85 p-8 text-white shadow-2xl backdrop-blur-xl sm:p-12">
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.2em] text-cyan-300">Message received</p>
      <h1 class="mb-4 text-3xl font-black sm:text-4xl">Thanks for reaching out.</h1>
      <p class="mb-8 text-slate-300">Your message was sent successfully. I'll get back to you as soon as I can.</p>
      <a class="btn-primary inline-block rounded-full no-underline" href="/">Back to portfolio</a>
    </section>
  </main>
</BaseLayout>
