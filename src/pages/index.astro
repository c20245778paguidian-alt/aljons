---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../sections/Hero.astro';
import Project from '../sections/Project.astro';
import Myservices from '../sections/Myservices.astro';
import Contact from '../sections/Contact.astro';
import Mypvice from '../sections/Mypvice.astro';
---

<BaseLayout>
  <Header />
  <main class="max-w-6xl mx-auto px-6 py-16 mb-12 flex flex-col gap-24 text-left">
    <Hero />
    <Project />
    <Myservices />
    <Contact />
  </main>
  <Mypvice />
  <Footer />
</BaseLayout>
