<section id="contact" class="card reveal min-h-[60vh] bg-white dark:bg-slate-900 border-4 border-black dark:border-white p-6 shadow-[8px_8px_0px_0px_rgba(0,0,0,1)] dark:shadow-[8px_8px_0px_0px_rgba(255,255,255,1)]">
  <h2 class="text-2xl font-black uppercase tracking-tight bg-red-600 text-white dark:bg-white dark:text-black p-2 mb-4 inline-block">
    Let's Build!
  </h2>
  <form id="contact-form" class="flex flex-col gap-4">
    <div>
      <label for="name" class="block font-black text-xs uppercase tracking-wider mb-1">Name</label>
      <input id="name" name="name" type="text" placeholder="ENTER YOUR NAME" required
        class="form-input w-full border-4 border-black dark:border-white p-3 font-bold text-sm bg-white dark:bg-slate-800 text-black dark:text-white focus:outline-none uppercase" />
    </div>
    <div>
      <label for="email" class="block font-black text-xs uppercase tracking-wider mb-1">Email</label>
      <input id="email" name="email" type="email" placeholder="ENTER YOUR EMAIL" required
        class="form-input w-full border-4 border-black dark:border-white p-3 font-bold text-sm bg-white dark:bg-slate-800 text-black dark:text-white focus:outline-none uppercase" />
    </div>
    <div>
      <label for="message" class="block font-black text-xs uppercase tracking-wider mb-1">Message</label>
      <textarea id="message" name="message" rows="3" placeholder="YOUR MESSAGE..." required
        class="form-input w-full border-4 border-black dark:border-white p-3 font-bold text-sm bg-white dark:bg-slate-800 text-black dark:text-white focus:outline-none uppercase"></textarea>
    </div>
    <button type="submit" class="btn-primary w-full mt-2">Submit</button>
  </form>
</section>
